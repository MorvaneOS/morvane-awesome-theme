# Maintainer: Clove Twilight <clove@doughmination.gay>
#
# The MorvaneOS look for awesome. Everything installed is generated by tools/build.py
# and committed, so building the package needs nothing but the repo.

pkgname=morvane-awesome-theme
pkgver=1.0.0
pkgrel=1
pkgdesc='MorvaneOS theme for awesome: colours and wallpaper'
arch=(any)
url='https://github.com/MorvaneOS/morvane-awesome-theme'
license=(LGPL-2.1-or-later)
depends=(
  awesome
  morvane-gtk-theme   # GTK apps, icons, cursor
  morvane-wm-theme    # xterm and alacritty
  morvane-wallpapers
)

package() {
  install -Dm644 "$startdir"/theme/theme.lua -t "$pkgdir/usr/share/awesome/themes/morvane/"
}
